<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!--
        Minimal entitlements for an unsigned sideloaded build.
        $(AppIdentifierPrefix) is an Xcode build variable that only expands
        during a real signed build — leaving it literal breaks FeatherSign.
        FeatherSign (and AltStore/Sideloadly) inject application-identifier
        and com.apple.developer.team-identifier from your cert automatically.
    -->
    <key>get-task-allow</key>
    <true/>
</dict>
</plist>
